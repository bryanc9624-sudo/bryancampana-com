---
// src/layouts/Base.astro
import '../styles/base.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { coverFor } from '../lib/projectImages'

interface Props {
  title: string; description?: string; noindex?: boolean; wide?: boolean
  /** Picture shown when the page's URL is pasted into LinkedIn, Slack, Messages, mail. */
  image?: ImageMetadata | null
}
const { title, description = 'Portfolio of Bryan Campana.', noindex = false, wide = false,
        image = null } = Astro.props

const site = Astro.site ?? new URL('https://bryancampana.com')
const canonical = new URL(Astro.url.pathname, site)

// Every page gets a preview picture. A project page uses its own cover; everything else
// falls back to 590 Madison Ave — Bryan's pick, 2026-09-07. Rendered to JPEG at the size
// the platforms actually read (1200x630-ish): they do not run our srcset, and several
// still refuse WebP, so this is one plain file rather than a responsive set.
const social = image ?? coverFor('590-madison-ave')
const og = social ? await getImage({ src: social, width: 1200, format: 'jpeg', quality: 80 }) : null
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The 404 body is served at every unknown URL, so it must not claim a canonical. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bryan Campana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={new URL(og.src, site)} />}
    {og && <meta property="og:image:width" content={String(og.attributes.width ?? og.options.width)} />}
    {og && <meta property="og:image:height" content={String(og.attributes.height ?? og.options.height)} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={wide ? 'page page--wide' : 'page'} tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
