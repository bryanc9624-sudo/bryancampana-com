---
// src/pages/index.astro
import { visibleProjects } from '../lib/projects'
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'

const featured = (await visibleProjects()).filter(p => p.data.featured)
---
<Base title="Bryan Campana — Designer" description="Designer working across signage, identity, and visual systems.">
  <section class="intro">
    <h1 class="intro__lede">Bryan Campana is a graphic designer working in visual systems: typography, information hierarchy, and the standards that keep a body of work consistent.</h1>
    <p><a href="/work">See all work &rarr;</a></p>
  </section>

  <section class="featured" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="eyebrow eyebrow--section">Featured work</h2>
    <ul class="grid grid--duo">
      {featured.map(p => <li><ProjectCard project={p} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .intro { margin-block: var(--space-7) var(--space-7); }
  .intro__lede { font-size: var(--size-lg); line-height: var(--leading-snug); max-width: var(--measure-prose); margin-bottom: var(--space-4); }
</style>
