---
import { visibleProjects } from '../../lib/projects'
import Base from '../../layouts/Base.astro'
import ProjectCard from '../../components/ProjectCard.astro'

const all = await visibleProjects()

// Chips are derived from the union of every project's keywords — add a keyword to a
// content file and a filter link appears. Nothing here is hardcoded.
const keywords = [...new Set(all.flatMap(p => p.data.keywords))].sort()

// Radio id needs to be a valid, stable token; the keyword itself may contain spaces.
const slug = (k: string) => k.toLowerCase().replace(/[^a-z0-9]+/g, '-')

// One pair of rules per keyword, generated from the same derived list that renders the
// links. Adding a keyword to any content file produces both a link and its rule — there
// is nothing to keep in sync by hand. `~=` matches one word in the space-separated
// data-keywords list, so a project with several keywords appears under each.
const filterCss = keywords.map(k => `
  .filter:has(#kw-${slug(k)}:checked) ~ .work-grid > li { display: none; }
  .filter:has(#kw-${slug(k)}:checked) ~ .work-grid > li[data-keywords~="${slug(k)}"] { display: block; }
`).join('')
---
<Base title="Work — Bryan Campana" description="Selected design, art, and photography projects.">
  <h1>Work</h1>

  <!-- No JavaScript. Radio inputs + sibling selectors do the filtering, so this works
       with JS disabled. Trade-off: filter state cannot live in the URL, so a filtered
       view is not linkable and does not survive a refresh. -->
  <form class="filter" aria-label="Filter work by keyword">
    <input type="radio" name="kw" id="kw-all" value="all" checked />
    <label class="filterlink" for="kw-all">All<span class="filterlink__count">{all.length}</span></label>
    {keywords.map(k => (
      <>
        <input type="radio" name="kw" id={`kw-${slug(k)}`} value={slug(k)} />
        <label class="filterlink" for={`kw-${slug(k)}`}>
          {k}<span class="filterlink__count">{all.filter(p => p.data.keywords.includes(k)).length}</span>
        </label>
      </>
    ))}
  </form>

  <ul class="grid work-grid">
    {all.map(p => (
      <li data-keywords={p.data.keywords.map(slug).join(' ')}><ProjectCard project={p} level={2} /></li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: var(--size-2xl); margin-block: var(--space-6) var(--space-4); }

  .filter {
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5); padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .filter input { position: absolute; opacity: 0; pointer-events: none; }

  /* FilterLink is the Eyebrow tier — DF-005. Uppercase, 15px, SemiBold, 8% tracking, the
     same type as a section eyebrow rather than body copy. Chips are long gone.
     Label and count are now the SAME size and weight and are separated by colour alone:
     ink label, muted count. There is no value lighter than muted in the palette —
     placeholder is #F0F0F0, about 1.2:1 on white and unreadable as text — so the two
     tokens that exist do the work rather than a third being invented. */
  .filterlink {
    color: var(--color-fg);
    font-size: var(--size-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    cursor: pointer;
  }
  /* 6px, matching the component's auto-layout gap. No line-height or vertical-align of its
     own any more: it is the same size as the label now, so it cannot grow the line box and
     needs none of the protection the raised-then-baselined figure did. */
  .filterlink__count {
    margin-left: 6px;
    font-size: inherit;
    font-weight: inherit;
    color: var(--color-muted);
  }
  /* Selected is Bold plus an underline — the `Eyebrow / Selected` style. Still two cues,
     but neither is the accent: DF-005 restored the settled rule that the charge appears on
     hover and never at rest, so a permanently-violet control would make it decorative.
     Underline is the device the colour system already reserves for text links. */
  .filter input:checked + .filterlink {
    color: var(--color-fg);
    font-weight: var(--weight-bold);
    text-decoration: underline;
  }
  /* The count does not take the selected emphasis. Figma's Selected variant keeps its Count
     node on the plain `Eyebrow` style — SemiBold, no underline — while only the Label takes
     `Eyebrow / Selected`. The count is an annotation of the label, not part of it.
     `display: inline-block` is load-bearing, not decoration: text-decoration propagates from
     the parent and paints straight through a child, and setting `text-decoration: none` on
     the child does NOT lift it. Only a new inline formatting context stops the line. */
  .filter input:checked + .filterlink .filterlink__count {
    font-weight: var(--weight-semibold);
    display: inline-block;
  }
  /* The charge, on hover only. The count keeps its muted colour — it is set explicitly, so
     it does not inherit this. */
  .filterlink:hover { color: var(--color-accent); }
  .filter input:focus-visible + .filterlink { outline: 2px solid var(--color-focus); outline-offset: 3px; }
</style>

<style is:global set:html={`
  .filter:has(#kw-all:checked) ~ .work-grid > li { display: block; }
${filterCss}`}></style>
