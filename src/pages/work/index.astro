---
import { visibleProjects } from '../../lib/projects'
import Base from '../../layouts/Base.astro'
import ProjectCard from '../../components/ProjectCard.astro'

const all = await visibleProjects()

// Chips are derived from the union of every project's keywords — add a keyword to a
// content file and a filter link appears. Nothing here is hardcoded.
const keywords = [...new Set(all.flatMap(p => p.data.keywords))].sort()

// Radio id needs to be a valid, stable token; the keyword itself may contain spaces.
const slug = (k: string) => k.toLowerCase().replace(/[^a-z0-9]+/g, '-')

// One pair of rules per keyword, generated from the same derived list that renders the
// links. Adding a keyword to any content file produces both a link and its rule — there
// is nothing to keep in sync by hand. `~=` matches one word in the space-separated
// data-keywords list, so a project with several keywords appears under each.
const filterCss = keywords.map(k => `
  .filter:has(#kw-${slug(k)}:checked) ~ .work-grid > li { display: none; }
  .filter:has(#kw-${slug(k)}:checked) ~ .work-grid > li[data-keywords~="${slug(k)}"] { display: block; }
`).join('')
---
<Base title="Work — Bryan Campana" description="Selected design, art, and photography projects.">
  <h1>Work</h1>

  <!-- No JavaScript. Radio inputs + sibling selectors do the filtering, so this works
       with JS disabled. Trade-off: filter state cannot live in the URL, so a filtered
       view is not linkable and does not survive a refresh. -->
  <form class="filter" aria-label="Filter work by keyword">
    <input type="radio" name="kw" id="kw-all" value="all" checked />
    <label class="filterlink" for="kw-all">All<sup class="filterlink__count">{all.length}</sup></label>
    {keywords.map(k => (
      <>
        <input type="radio" name="kw" id={`kw-${slug(k)}`} value={slug(k)} />
        <label class="filterlink" for={`kw-${slug(k)}`}>
          {k}<sup class="filterlink__count">{all.filter(p => p.data.keywords.includes(k)).length}</sup>
        </label>
      </>
    ))}
  </form>

  <ul class="grid work-grid">
    {all.map(p => (
      <li data-keywords={p.data.keywords.map(slug).join(' ')}><ProjectCard project={p} level={2} /></li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: var(--size-2xl); margin-block: var(--space-6) var(--space-4); }

  .filter {
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5); padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .filter input { position: absolute; opacity: 0; pointer-events: none; }

  /* FilterLink, per Figma 2026-09-07. Chips are gone: border, padding and radius
     removed. They were the only rectangles on the site and read as heavy chrome
     against a design that is otherwise hairlines and type. */
  .filterlink {
    color: var(--color-muted);
    font-size: var(--size-base);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    cursor: pointer;
  }
  .filterlink__count {
    margin-left: 0.15em;
    font-size: var(--size-xs);
    font-weight: var(--weight-regular);
    color: var(--color-muted);
    vertical-align: super;
    line-height: 0;
  }
  /* Two cues, not one: weight and colour both change, so the selected state survives
     for anyone who cannot distinguish the hue. --color-accent is what this token marks. */
  .filter input:checked + .filterlink {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }
  .filter input:checked + .filterlink .filterlink__count { color: var(--color-accent); }
  .filter input:focus-visible + .filterlink { outline: 2px solid var(--color-focus); outline-offset: 3px; }
</style>

<style is:global set:html={`
  .filter:has(#kw-all:checked) ~ .work-grid > li { display: block; }
${filterCss}`}></style>
