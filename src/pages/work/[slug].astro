---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import ProjectStandard from '../../components/ProjectStandard.astro'
import ProjectPhotography from '../../components/ProjectPhotography.astro'
import ProjectNav from '../../components/ProjectNav.astro'
import { imagesFor } from '../../lib/projectImages'

// Spec §3: every project gets a page. `featured` controls presentation only.
export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  return all.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }))
}

const { project, prev, next } = Astro.props
const d = project.data
const { Content } = await render(project)

// Ten projects have no Markdown body. Check the raw body rather than trusting the
// component — an empty <Content /> still occupies its wrapper, leaving a stray margin.
const hasBody = (project.body ?? '').trim().length > 0

const facts = [
  ['Completed', d.completed],
  ['Discipline', d.discipline],
  ['Medium', d.medium],
  ['Prints', d.prints],
  ['Dimensions', d.dimensions],
].filter(([, v]) => v) as [string, string][]

const photos = imagesFor(project.id)

// Spec §5: layout keys off the single canonical discipline, never off `featured` and
// never off `keywords` — keywords are unordered, so ordering them differently must not
// be able to change a page's layout.
const isPhotography = d.discipline === 'Photography'
const Layout = isPhotography ? ProjectPhotography : ProjectStandard
---
<Base title={`${d.title} — Bryan Campana`} description={d.scope} wide={!isPhotography}>
  <Layout project={project} photos={photos} facts={facts} hasBody={hasBody}>
    <Content />
  </Layout>

  <ProjectNav prev={prev} next={next} />
</Base>
