---
import { render } from 'astro:content'
import { visibleProjects } from '../../lib/projects'
import Base from '../../layouts/Base.astro'
import ProjectStandard from '../../components/ProjectStandard.astro'
import ProjectPhotography from '../../components/ProjectPhotography.astro'
import { imagesFor, coverFor } from '../../lib/projectImages'

// Spec §3: every project gets a page. `featured` controls presentation only.
export async function getStaticPaths() {
  const all = await visibleProjects()
  return all.map(p => ({ params: { slug: p.id }, props: { project: p } }))
}

const { project } = Astro.props
const d = project.data
const { Content } = await render(project)

// Ten projects have no Markdown body. Check the raw body rather than trusting the
// component — an empty <Content /> still occupies its wrapper, leaving a stray margin.
const hasBody = (project.body ?? '').trim().length > 0

const facts = [
  ['Completed', d.completed],
  ['Discipline', d.discipline],
  ['Medium', d.medium],
  ['Prints', d.prints],
  ['Dimensions', d.dimensions],
].filter(([, v]) => v) as [string, string][]

const photos = imagesFor(project.id)
// The video facade's poster. The three video projects have no gallery images at all, so
// without this they fall back to the ink ground; their cover.jpg is the still.
const poster = photos[0] ?? coverFor(project.id, d.cover)

// Layout is chosen by its own field, never inferred from content. `discipline` is a
// label, `keywords` are an unordered set — neither should be able to change how a page
// is built.
const imageFirst = d.layout === 'image-first'
const Layout = imageFirst ? ProjectPhotography : ProjectStandard
---
<Base title={`${d.title} — Bryan Campana`} description={d.scope} wide={!imageFirst}
      image={coverFor(project.id, d.cover)}>
  <Layout project={project} photos={photos} poster={poster} facts={facts} hasBody={hasBody}>
    <Content />
  </Layout>
</Base>
