---
// src/pages/privacy.astro
import Base from '../layouts/Base.astro'
---
<Base title="Privacy Policy — Bryan Campana" description="Privacy policy.">
  <div class="prose">
    <h1>Privacy Policy</h1>
    <p>Last Updated: January 1, 2025</p>
    <p>This Privacy Policy describes how personal information is collected, used, and shared when you interact with bryancampana.com.</p>
    <h2>Information Collected</h2>
    <p>If you use the contact form, I may collect your name, email address, or any other information you provide. When you purchase products, order details are collected and securely processed by Stripe. I do not store or process payment card details directly. Basic technical data such as browser type, device information, and anonymized traffic statistics may also be collected to improve performance.</p>
    <h2>Sharing of Information</h2>
    <p>I do not sell, rent, or trade your personal information. Order and payment information is shared with Stripe to complete transactions. For details, review Stripe’s Privacy Policy.</p>
    <h2>Use of Information</h2>
    <p>Personal information is used to respond to inquiries, process and fulfill orders, and improve the website.</p>
    <h2>Your Rights</h2>
    <p>You may request the deletion of your personal information at any time by contacting me.</p>
    <!-- source: archive/content/privacy-policy-1.md (lines 7+) -->
  </div>
</Base>

<style>
  .prose { margin-block: var(--space-6); max-width: var(--measure-prose); }
  .prose h1 { font-size: var(--size-xl); margin-bottom: var(--space-4); }
  .prose h2 { font-size: var(--size-lg); margin-top: var(--space-5); margin-bottom: var(--space-3); }
</style>
