---
// src/components/SiteHeader.astro
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
]
const path = Astro.url.pathname
---
<header class="page site-header">
  <a href="/" class="site-header__name">Bryan Campana</a>
  <nav aria-label="Primary">
    <ul>
      {links.map(l => (
        <li>
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: var(--space-4); padding-block: var(--space-4);
    /* Ink, not hairline: the header rule marks the end of the site chrome, not a break
       within the content. Settled 2026-09-07, "Horizontal rules get a hierarchy". */
    border-bottom: 1px solid var(--color-fg);
  }
  .site-header__name { font-weight: var(--weight-semibold); text-decoration: none; }
  ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }

  /* Spec §8: aria-current was set but had no visual treatment. Figma shows the
     active nav item at --color-fg and inactive at --color-muted. */
  nav a { color: var(--color-muted); }
  nav a[aria-current='page'] { color: var(--color-fg); }
</style>
