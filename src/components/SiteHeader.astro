---
// src/components/SiteHeader.astro
import { navLinks as links, isCurrentPage } from '../lib/nav'
const path = Astro.url.pathname
---
<header class="site-header">
  <a href="/" class="site-header__name">Bryan Campana</a>
  <nav aria-label="Primary">
    <ul>
      {links.map(l => (
        <li>
          <a href={l.href} aria-current={isCurrentPage(path, l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      {/* No Contact here. D-060: it lived in three places — header, footer and About —
          and now lives only on About. D-049's reasoning (people do not reach the bottom
          of a page) still holds and is outweighed by having one place for contact. */}
    </ul>
  </nav>
</header>

<style>
  /* Full bleed, not `.page`. The chrome is the edge of the page, so it spans the viewport
     and pads its contents in from the window edge. Previously this carried `.page`
     (--page-max, 1440) while project pages render at --page-max-wide (1600), so on a wide
     screen the header was 80px narrower per side than the work it framed. */
  .site-header {
    display: flex; align-items: baseline;
    justify-content: flex-start; gap: var(--space-6);
    padding-block: var(--space-4); padding-inline: var(--page-pad);
    /* No rule. The chrome is marked by position and space, not a line. Settled
       2026-09-07, "The chrome rules are gone"; the spacing here is what separates it. */
  }
  /* Serif because the name is identity, not navigation. --font-display, not --font-serif:
     the token carries the role. Size is the inherited --size-base — it shares a line with
     the nav and must not step up. Weight, not size, is what separates it. */
  .site-header__name {
    font-family: var(--font-display); font-weight: var(--weight-semibold);
  }
  ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }

  /* Spec §8: aria-current was set but had no visual treatment. Figma shows the
     active nav item at --color-fg and inactive at --color-muted. Undecorated via the base
     `a` rule — the nav's states are colour and weight, and hover is the charge; an
     underline was never one of them. */
  nav a { color: var(--color-muted); }
  /* Weight as well as colour. Required, not cosmetic: softening --color-muted pushes a
     colour-only cue toward invisible, and this is the one place that rule was never
     applied. 500 rather than FilterLink's 600 — the nav sits beside a 600 serif wordmark. */
  nav a[aria-current='page'] { color: var(--color-fg); font-weight: var(--weight-medium); }

  /* The stack stays even though Contact left the row. D-060 re-measured it: at 390px the
     row is 307px against 342px of content, so it does fit there — but this query runs
     0–639px, and at 320px there is only 272px of content. The row stops fitting below a
     355px viewport, which is inside the range. So it stacks: name, then nav, flush left. */
  @media (max-width: 39.999rem) {
    .site-header { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }
</style>
