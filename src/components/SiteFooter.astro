---
// src/components/SiteFooter.astro
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <p>&copy; {year} Bryan Campana</p>
  <ul>
    <li><a href="https://www.linkedin.com/in/bryancampana/" rel="me noopener">LinkedIn</a></li>
    <li><a href="/terms">Terms of Use</a></li>
    <li><a href="/privacy">Privacy Policy</a></li>
  </ul>
</footer>

<style>
  /* Full bleed, matching the header — see SiteHeader. Contact moved to the nav. */
  .site-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: var(--space-3); margin-top: var(--space-7);
    padding-block: var(--space-4); padding-inline: var(--page-pad);
    /* No rule — matching the header. See SiteHeader. */
    color: var(--color-muted); font-size: var(--size-sm);
  }
  .site-footer p { margin: 0; }
  ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
</style>
