---
// A facade for an embedded video. Renders a poster and a play button; the provider's
// iframe is only created when someone actually presses play.
//
// Why: a plain YouTube or Vimeo iframe pulls roughly a megabyte of third-party
// JavaScript on page load, whether or not anyone watches — more than every image on this
// site combined — and sets third-party cookies while doing it. Most visitors scroll past.
// This is the only JavaScript on the site, and inline video playback is the one thing
// that genuinely requires it.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  video: { provider: 'youtube' | 'vimeo'; id: string; title?: string }
  poster?: ImageMetadata | null
  projectTitle: string
}
const { video, poster = null, projectTitle } = Astro.props
const label = video.title ?? projectTitle

const src = video.provider === 'youtube'
  ? `https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`
  : `https://player.vimeo.com/video/${video.id}?autoplay=1`
---
<figure class="video">
  <button class="video__btn" type="button" data-src={src} aria-label={`Play video: ${label}`}>
    {poster
      ? <Image src={poster} alt="" widths={[600, 1000, 1600]}
               sizes="(min-width: 64rem) 62vw, 100vw" loading="lazy" decoding="async" class="video__poster" />
      : <span class="video__ground" aria-hidden="true"></span>}
    <span class="video__label" aria-hidden="true">Play</span>
  </button>
</figure>

<script>
  // Progressive enhancement: without JS the button simply does nothing and the poster
  // stays, rather than leaving a dead embed. Delegated so it costs one listener.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('.video__btn')
    if (!btn) return
    const src = btn.dataset.src
    if (!src) return
    const frame = document.createElement('iframe')
    frame.src = src
    frame.title = btn.getAttribute('aria-label')?.replace(/^Play video: /, '') ?? 'Video'
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture'
    frame.allowFullscreen = true
    frame.className = 'video__frame'
    btn.replaceWith(frame)
    frame.focus()
  })
</script>

<style>
  .video { margin: 0; }
  /* DF-006: a vertical stack, not a label floated over the image. `text-align: left`
     because a button centres its text by default and the label used to be absolutely
     positioned, so nothing had to say so before. */
  .video__btn {
    display: flex; flex-direction: column; gap: var(--space-2);
    width: 100%; padding: 0; text-align: left;
    border: 0; background: none; cursor: pointer; color: inherit;
  }
  .video__poster { width: 100%; height: auto; display: block; }

  /* Ink, not grey. Grey is this site's placeholder colour, so a grey video block reads
     as a missing image rather than something you can press. All three video projects
     have stills now, so this renders for nothing today — it stays as the deliberate
     state for any project that ships without one. */
  .video__ground {
    display: block; width: 100%; aspect-ratio: 16 / 9;
    background: var(--color-fg);
  }

  /* The Label text style — 13px Medium, 140% — which is what Figma binds this node to.
     No icon: the design has no icon language anywhere and three videos do not justify
     inventing one.

     DF-006 moved this below the image and changed it from --color-bg to --color-fg. It
     was never really "on the page's ground": it sat on a photograph, so it had no
     derivable contrast — near-black on an image in dark mode, white on one in light, the
     image deciding. That was correct when two of three videos had no still and the ink
     block WAS the ground; the content moved underneath the decision. Below the image it
     is on paper and measures like everything else, 15.42:1 light and 19.45:1 dark.

     No underline: the whole facade is the target, the same reasoning that keeps
     underlines off card titles. Hover needs its own rule because this is a button, not an
     anchor, so the global a:hover does not reach it. */
  .video__label {
    font-family: var(--font-sans);
    font-size: var(--size-xs); font-weight: var(--weight-medium);
    line-height: var(--leading-label);
    color: var(--color-fg);
    text-transform: uppercase; letter-spacing: var(--tracking-wide);
  }
  .video__btn:hover .video__label { color: var(--color-accent); }
  .video__btn:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
</style>

<style is:global>
  .video__frame { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
</style>
