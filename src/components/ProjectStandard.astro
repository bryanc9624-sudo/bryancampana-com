---
// Spec §5, standard layout. Sticky text rail plus wide media column at 64rem+; stacked
// text-first below. Used by everything that is not a photography project.
import type { CollectionEntry } from 'astro:content'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Placeholder from './Placeholder.astro'
import ProjectFacts from './ProjectFacts.astro'
import { showDraftFlag } from '../lib/projects'
import VideoFacade from './VideoFacade.astro'

interface Props {
  project: CollectionEntry<'projects'>
  photos: ImageMetadata[]
  poster: ImageMetadata | null
  facts: [string, string][]
  hasBody: boolean
}
const { project, photos, poster, facts, hasBody } = Astro.props
const d = project.data
const placeholders = ['16/9', '3/2', '1/1', '3/2']
---
<article class="case">
  <div class="case__rail">
    {showDraftFlag && d.draft && <p class="case__draft">Draft — hidden when built</p>}
    <p class="case__eyebrow"><a href="/work">Work</a></p>
    <h1>{d.title}</h1>
    <p class="case__scope">{d.scope}</p>
    {d.designQuestion && <p class="case__question">{d.designQuestion}</p>}

    <ProjectFacts facts={facts} />

    {hasBody && <div class="case__body"><slot /></div>}

    <p class="case__back"><a href="/work">&larr; All work</a></p>
  </div>

  {d.video && (
    <div class="case__video">
      <VideoFacade video={d.video} poster={poster} projectTitle={d.title} />
    </div>
  )}

  <div class="case__media">
    {photos.length > 0
      ? photos.map((img, i) => (
          <figure class="case__figure">
            <Image src={img} alt={d.images[i]?.caption ?? `${d.title} — image ${i + 1}`}
                   widths={[600, 1000, 1600]}
                   sizes="(min-width: 64rem) 62vw, 100vw"
                   loading={i === 0 ? 'eager' : 'lazy'}
                   fetchpriority={i === 0 ? 'high' : 'auto'}
                   decoding="async" class="case__img" />
            {d.images[i]?.caption && <figcaption>{d.images[i].caption}</figcaption>}
          </figure>
        ))
      : placeholders.map((aspect, i) => (
          <figure class="case__figure">
            <Placeholder aspect={aspect} label={`${d.title} — image placeholder ${i + 1} of ${placeholders.length}`} />
          </figure>
        ))}
  </div>
</article>

<style>
  .case { display: grid; gap: var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 64rem) {
    .case { grid-template-columns: minmax(280px, 1fr) 2fr; }
    /* align-self is load-bearing: a grid child stretches to the row height by default,
       and a sticky element with nowhere to travel silently does nothing. */
    .case__rail { position: sticky; top: var(--space-5); align-self: start; }
  }
  .case__rail { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-6); }
  .case__eyebrow {
    font-family: var(--font-sans); font-weight: var(--weight-medium);
    line-height: var(--leading-eyebrow);
    margin: 0; font-size: var(--size-sm);
    text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-muted);
  }
  .case h1 { font-size: var(--size-2xl); }
  .case__scope { font-size: var(--size-lg); line-height: var(--leading-snug); margin: 0; }
  /* --font-italic, not --font-body: this line is italic. See tokens.css. */
  .case__question { margin: 0; color: var(--color-muted); font-family: var(--font-italic);
    font-style: italic; line-height: var(--leading-snug); }
  .case__body { margin: 0; }
  .case__back { margin: 0; }
  .case__media { display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-6); }
  .case__figure { margin: 0; }
  .case__img { width: 100%; height: auto; display: block; }
  figcaption { margin-top: var(--space-2); color: var(--color-muted); font-size: var(--size-sm); }
  .case__video { margin-bottom: var(--space-5); }
  .case__draft {
    margin: 0 0 var(--space-2); font-family: var(--font-sans); font-size: var(--size-xs);
    font-weight: var(--weight-medium); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-accent);
  }
</style>
