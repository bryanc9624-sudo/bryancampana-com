---
// src/components/ProjectCard.astro
import type { CollectionEntry } from 'astro:content'
import Placeholder from './Placeholder.astro'
import { Image } from 'astro:assets'
import { coverFor } from '../lib/projectImages'
import { showDraftFlag } from '../lib/projects'
interface Props {
  project: CollectionEntry<'projects'>
  /** Heading level for the card title. The landing page nests cards under an h2
      ("Featured") so they are h3 there; /work/ has no such section heading, so
      they sit directly under its h1 and must be h2. A card cannot know this itself. */
  level?: 2 | 3
}
const { project, level = 3 } = Astro.props
const Title = `h${level}` as 'h2' | 'h3'
const d = project.data
// Spec §3: every project has a page now, so every card links.
const href = `/work/${project.id}`
const keyword = d.keywords[0] ?? null
const cover = coverFor(project.id, d.cover)
---
<article class="card">
  <a href={href} class="card__media" tabindex="-1" aria-hidden="true">
    {cover
      ? <div class="card__frame">
          <Image src={cover} alt={d.title} widths={[400, 700, 1000]}
                 sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                 loading="lazy" decoding="async" class="card__img" />
        </div>
      : <Placeholder aspect={d.aspect} label={`${d.title} — image placeholder`} />}
  </a>

  {showDraftFlag && d.draft && <p class="card__draft">Draft — hidden when built</p>}

  {keyword && <p class="card__keyword">{keyword}</p>}

  <Title class="card__title">
    <a href={href}>{d.title}</a>
  </Title>

  <p class="card__scope">{d.scope}</p>

</article>

<style>
  .card { display: flex; flex-direction: column; gap: var(--space-2); }
  .card__media { display: block; }
  /* Figma's ProjectCard Media frame is 437x291 - 3:2 - with a fixed height, so every
     card is the same shape whatever the image inside it. Without this the natural
     ratio sets the card height and the text below sits at a different baseline in
     every column, which is what broke the grid. */
  .card__frame { aspect-ratio: 3 / 2; overflow: hidden; }
  .card__img {
    width: 100%; height: 100%; display: block;
    /* cover fills the frame and crops the overflow; contain would letterbox and
       reintroduce the ragged edges this is meant to remove. */
    object-fit: cover;
    object-position: center;
  }
  .card__title { font-size: var(--size-lg); margin-top: var(--space-2); }
  /* Undecorated at rest via the base `a` rule; the underline here is a hover STATE. */
  .card__title a:hover { text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .card__scope { margin: 0; }
  /* Dev only. Never present in a production build, because a draft has no page there. */
  .card__draft {
    margin: 0; font-family: var(--font-sans); font-size: var(--size-xs);
    font-weight: var(--weight-medium); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-muted);
  }
  /* The Label text style, 13px — not Eyebrow's 15px. Figma has said Label since the
     component was drawn; the code had --size-sm and the two tiers were identical in size,
     weight, case, tracking and colour. D-064 gave the section eyebrow the ink on the
     reasoning that "size always did" separate them, which was true in Figma and not here.
     Now it is true in both. */
  .card__keyword {
    margin: 0; color: var(--color-muted); font-size: var(--size-xs);
    font-family: var(--font-sans);
    font-weight: var(--weight-medium); line-height: var(--leading-label);
    text-transform: uppercase; letter-spacing: var(--tracking-wide);
  }
</style>
