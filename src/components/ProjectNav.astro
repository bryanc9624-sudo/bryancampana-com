---
// Spec §8: Previous/Next project navigation existed on the Cargo site and was missing
// from the rebuild. Ordered by `order` across all 14 projects, not scoped to a keyword —
// the filter is a view of the index, not a traversal order, and scoping this to it would
// make the sequence depend on how the visitor arrived.
import type { CollectionEntry } from 'astro:content'
interface Props {
  prev: CollectionEntry<'projects'> | null
  next: CollectionEntry<'projects'> | null
}
const { prev, next } = Astro.props
---
{(prev || next) && (
  <nav class="projectnav" aria-label="Project">
    <div class="projectnav__side">
      {prev && (
        <a href={`/work/${prev.id}`} rel="prev">
          <span class="projectnav__label">Previous</span>
          <span class="projectnav__title">{prev.data.title}</span>
        </a>
      )}
    </div>
    <div class="projectnav__side projectnav__side--end">
      {next && (
        <a href={`/work/${next.id}`} rel="next">
          <span class="projectnav__label">Next</span>
          <span class="projectnav__title">{next.data.title}</span>
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .projectnav {
    display: flex; justify-content: space-between; gap: var(--space-5);
    margin-top: var(--space-7); padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }
  .projectnav__side { min-width: 0; }
  /* Keeps Next hard right even when Previous is absent on the first project. */
  .projectnav__side--end { margin-left: auto; text-align: right; }
  .projectnav a { display: block; text-decoration: none; }
  .projectnav a:hover .projectnav__title { text-decoration: underline; }
  .projectnav__label {
    display: block; font-size: var(--size-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }
  .projectnav__title { display: block; margin-top: var(--space-1); font-size: var(--size-lg); }
</style>
