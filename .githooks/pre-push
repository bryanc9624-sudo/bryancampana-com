#!/bin/sh
#
# Makes the deploy gate's verdict visible before the push, so a build is never a
# surprise in either direction.
#
# The gate is netlify.toml's `ignore`: --pretty=%s, anchored at ^. Subject only.
# An earlier version read %B, matched bodies that discussed the rule, and fired 19
# builds — a whole cycle (D-052). Because the anchor is now in place, a body
# mentioning the tag is harmless, and this hook says so rather than blocking it:
# commit messages here discuss deploys constantly, and an earlier version of this
# hook refused the very commit that introduced it.
#
# What is left to catch is the quiet failure — a tag placed somewhere that reads
# as intent to publish but does not match the anchor, so nothing builds and you
# believe it did.
#
# Installed via: git config core.hooksPath .githooks

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue

	if [ "$remote_sha" = "$zero" ]; then
		range=$(git rev-list "$local_sha" --not --remotes)
	else
		range=$(git rev-list "$remote_sha..$local_sha")
	fi
	[ -z "$range" ] && continue

	for sha in $range; do
		short=$(git log -1 --pretty=%h "$sha")
		subject=$(git log -1 --pretty=%s "$sha")

		case "$subject" in
		'[deploy]'*)
			echo "BUILD: $short will publish to bryancampana.com" >&2
			echo "  $subject" >&2
			echo "  ~15 of ~1000 credits this cycle." >&2
			;;
		*'[deploy]'*)
			echo "BLOCKED: $short has [deploy] in its subject but NOT at the start." >&2
			echo "  $subject" >&2
			echo "" >&2
			echo "  netlify.toml anchors the tag at ^, so this publishes nothing while" >&2
			echo "  reading as though it does. Move the tag to the front:" >&2
			echo "    git rebase -i $short~1   # reword" >&2
			status=1
			;;
		*)
			if git log -1 --pretty=%b "$sha" | grep -q '\[deploy\]'; then
				echo "note: $short mentions [deploy] in its body — no build. $subject" >&2
			fi
			;;
		esac
	done
done

exit $status
